{
  "name": "verdflow",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @vf/shared build && pnpm --parallel --filter @vf/api --filter @vf/web dev",
    "dev:worker": "pnpm --filter @vf/api dev:worker",
    "db:migrate": "pnpm --filter @vf/shared build && pnpm --filter @vf/api db:migrate",
    "db:seed": "pnpm --filter @vf/api db:seed",
    "simulate": "pnpm --filter @vf/api simulate",
    "test": "pnpm --filter @vf/shared build && pnpm -r test",
    "typecheck": "pnpm --filter @vf/shared build && pnpm -r typecheck"
  }
}
