# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/verdflow
# Used only by the API tests; the database is wiped by the tests.
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/verdflow_test
API_PORT=4000
# Browser origin of the web app (cookies are SameSite=Strict).
WEB_ORIGIN=http://localhost:5173
# A heartbeat older than this means the radiologist is not present.
PRESENCE_STALE_SECONDS=60
# Same-patient continuity window when the order carries no encounter number.
CONTINUITY_WINDOW_HOURS=24
# Only radiologists on a rota shift receive new work. Set false only for a demo without a rota.
ROTA_REQUIRED=true
# Set true only behind HTTPS.
COOKIE_SECURE=false

# --- Operations ---
# Bearer token for /api/metrics (Prometheus). Without it, metrics are served to this machine only.
METRICS_TOKEN=
# HL7 messages per minute accepted from one sending address before 429.
INTAKE_RATE_PER_MINUTE=60000
# Parallel loops in each worker process.
WORKER_INTAKE_CONCURRENCY=8
WORKER_DELIVERY_CONCURRENCY=4
# Where `pnpm archive` writes old payloads (local only; production uses encrypted object storage).
ARCHIVE_DIR=

# --- Assistant ---
# Without a key the assistant still answers the common questions from VerdFlow's own data.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_ENABLED=true
